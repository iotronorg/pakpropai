# -------------------------------------------------------
# CORE DJANGO
# -------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
ENVIRONMENT=development

# -------------------------------------------------------
# DATABASE
# When using docker-compose, use the service name "db":
#   DATABASE_URL=postgresql://realtron:realtron@db:5432/realtron
# When running Django directly on your machine (no docker):
#   DATABASE_URL=postgresql://realtron:realtron@localhost:5432/realtron
# -------------------------------------------------------
DATABASE_URL=postgresql://realtron:realtron@db:5432/realtron

# -------------------------------------------------------
# REGIONAL DB CLUSTERS (GLOBAL-7 — EU/UK data residency)
# Leave blank in local dev — Django falls back to DATABASE_URL.
# Set these in production AFTER running: terraform apply -target=module.cluster_eu
# Format: postgresql://realtron:<password>@<rds-endpoint>:5432/<db_name>
# -------------------------------------------------------
EU_DATABASE_URL=
UK_DATABASE_URL=
UAE_DATABASE_URL=

# -------------------------------------------------------
# REDIS
# docker-compose:  redis://redis:6379/0
# local machine:   redis://localhost:6379/0
# -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------------------------------------
# BASE URL (used for generating PDF download links etc.)
# -------------------------------------------------------
BASE_URL=http://localhost:8000

# -------------------------------------------------------
# FRONTEND / CORS
# In dev this unlocks CORS for the Next.js dev server.
# In prod, set to the actual frontend domain (required — locks CORS to this origin).
# -------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# FRONTEND_URL=https://app.your-domain.com   (override in prod)
SENTRY_DSN=                               # optional — enables error monitoring

# -------------------------------------------------------
# AI BACKEND
# Set AI_BACKEND=local to use Ollama (no API key needed).
# Set AI_BACKEND=gemini and provide GEMINI_API_KEY for cloud.
# -------------------------------------------------------
AI_BACKEND=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LOCAL_MODEL=qwen2.5:7b
LOCAL_VISION_MODEL=llava:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# -------------------------------------------------------
# WHATSAPP CLOUD API
# Get these from Meta Business Manager → WhatsApp → API Setup
# Leave blank for local dev (WhatsApp flows will be skipped).
# Requires ngrok or similar to receive webhook messages locally.
# -------------------------------------------------------
WA_VERIFY_TOKEN=any-string-you-choose
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_OTP_TEMPLATE_NAME=

# -------------------------------------------------------
# PAYMENT GATEWAYS (sandbox — leave blank to skip)
# Safepay sandbox: https://getsafepay.com
# bSecure sandbox: https://bsecure.pk
# -------------------------------------------------------
SAFEPAY_MERCHANT_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_ENVIRONMENT=sandbox
BSECURE_CLIENT_ID=
BSECURE_CLIENT_SECRET=
BSECURE_MERCHANT_ID=
BSECURE_ENVIRONMENT=sandbox

# -------------------------------------------------------
# STRIPE (SaaS billing)
# Can be set here OR via Admin → Setup page (DB takes precedence over env vars).
# Dev webhook secret: run `stripe listen --forward-to localhost:8000/api/v1/billing/webhook/stripe/`
# -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEAL_LOCK_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# -------------------------------------------------------
# CLOUDINARY MEDIA STORAGE (optional — leave blank to use local disk)
# Get credentials from: cloudinary.com → Dashboard → API Keys
# -------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------------------------------
# TWILIO (Voice channel — leave blank to disable voice features)
# Get credentials from: console.twilio.com
# -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -------------------------------------------------------
# OPENTELEMETRY (optional — leave blank to disable distributed tracing)
# OTEL_EXPORTER_TYPE: tempo | jaeger | otlp
# -------------------------------------------------------
OTEL_SERVICE_NAME=realtron-ai
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_TYPE=tempo
