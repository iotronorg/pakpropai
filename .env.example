# -------------------------------------------------------
# CORE DJANGO
# -------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# -------------------------------------------------------
# DATABASE
# When using docker-compose, use the service name "db":
#   DATABASE_URL=postgresql://pakprop:pakprop@db:5432/pakpropai
# When running Django directly on your machine (no docker):
#   DATABASE_URL=postgresql://pakprop:pakprop@localhost:5432/pakpropai
# -------------------------------------------------------
DATABASE_URL=postgresql://pakprop:pakprop@db:5432/pakpropai

# -------------------------------------------------------
# REDIS
# docker-compose:  redis://redis:6379/0
# local machine:   redis://localhost:6379/0
# -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------------------------------------
# BASE URL (used for generating PDF download links etc.)
# -------------------------------------------------------
BASE_URL=http://localhost:8000

# -------------------------------------------------------
# PRODUCTION ONLY — set when deploying with prod.py settings
# -------------------------------------------------------
# FRONTEND_URL=https://app.pakpropai.com   (required in prod — locks CORS to this origin)
# SENTRY_DSN=                              (optional — enables error monitoring)

# -------------------------------------------------------
# AI BACKEND
# Set AI_BACKEND=local to use Ollama (no API key needed).
# Set AI_BACKEND=gemini and provide GEMINI_API_KEY for cloud.
# -------------------------------------------------------
AI_BACKEND=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LOCAL_MODEL=qwen2.5:7b
LOCAL_VISION_MODEL=llava:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# -------------------------------------------------------
# WHATSAPP CLOUD API
# Get these from Meta Business Manager → WhatsApp → API Setup
# Leave blank for local dev (WhatsApp flows will be skipped).
# Requires ngrok or similar to receive webhook messages locally.
# -------------------------------------------------------
WA_VERIFY_TOKEN=any-string-you-choose
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_OTP_TEMPLATE_NAME=

# -------------------------------------------------------
# PAYMENT GATEWAYS (sandbox — leave blank to skip)
# Safepay sandbox: https://getsafepay.com
# bSecure sandbox: https://bsecure.pk
# -------------------------------------------------------
SAFEPAY_MERCHANT_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_ENVIRONMENT=sandbox
BSECURE_CLIENT_ID=
BSECURE_CLIENT_SECRET=
BSECURE_ENVIRONMENT=sandbox

# -------------------------------------------------------
# CLOUDFLARE R2 STORAGE (optional — leave blank to use local disk)
# Create a bucket at dash.cloudflare.com → R2 → Create bucket
# Generate API token: R2 → Manage R2 API tokens → Create API token
# Set R2_PUBLIC_URL if your bucket has public access enabled.
# -------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
