# T-6010 — encrypted database backup. Install: docs/runbooks/backups.md
# Edit User= and the two paths to match the server (DEPLOY_DIR, e.g. /srv/realtron).
[Unit]
Description=RealTron encrypted database backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/realtron
ExecStart=/usr/bin/env bash /srv/realtron/ops/backup.sh
Nice=10
IOSchedulingClass=idle
