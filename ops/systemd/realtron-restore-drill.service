# T-6010 — restore drill: the newest backup into a throwaway container. Install: docs/runbooks/backups.md
[Unit]
Description=RealTron restore drill
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/realtron
ExecStart=/usr/bin/env bash /srv/realtron/ops/restore_drill.sh
Nice=10
IOSchedulingClass=idle
