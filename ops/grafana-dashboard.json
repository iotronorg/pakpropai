{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "RealTron AI — Platform Overview",
  "uid": "realtron-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["realtron"],
  "panels": [

    {
      "id": 1,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{
        "expr": "sum(rate(django_http_requests_total_by_method_total[1m])) by (method)",
        "legendFormat": "{{method}}"
      }]
    },

    {
      "id": 2,
      "title": "HTTP Error Rate (%)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{
        "expr": "100 * sum(rate(django_http_responses_total_by_status_total{status=~\"5..\"}[5m])) / sum(rate(django_http_responses_total_by_status_total[5m]))",
        "legendFormat": "5xx rate %"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } }
    },

    {
      "id": 3,
      "title": "API p95 Latency (s)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])) by (le))",
        "legendFormat": "p95"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 }] } } }
    },

    {
      "id": 4,
      "title": "DB Query Rate (q/s)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{
        "expr": "sum(rate(django_db_execute_total[1m]))",
        "legendFormat": "queries/s"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },

    {
      "id": 5,
      "title": "Cache Hit Rate (%)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{
        "expr": "100 * sum(rate(django_cache_get_hits_total[5m])) / (sum(rate(django_cache_get_hits_total[5m])) + sum(rate(django_cache_get_misses_total[5m])) + 0.001)",
        "legendFormat": "hit rate %"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 }] } } }
    },

    {
      "id": 6,
      "title": "WhatsApp Inbound Messages (msg/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{
        "expr": "sum(rate(realtron_whatsapp_messages_total{direction=\"inbound\"}[1m])) by (message_type) * 60",
        "legendFormat": "{{message_type}}"
      }]
    },

    {
      "id": 7,
      "title": "AI Requests by Route (req/min)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{
        "expr": "sum(rate(realtron_ai_requests_total[1m])) by (route, intent) * 60",
        "legendFormat": "{{route}}/{{intent}}"
      }]
    },

    {
      "id": 8,
      "title": "AI Response Latency Percentiles",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(realtron_ai_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(realtron_ai_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(realtron_ai_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p99 {{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 9,
      "title": "Deal Lock Funnel (events/hour)",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "sum(increase(realtron_deal_locks_total{status=\"initiated\"}[1h]))", "legendFormat": "Initiated" },
        { "expr": "sum(increase(realtron_deal_locks_total{status=\"locked\"}[1h]))", "legendFormat": "Locked" },
        { "expr": "sum(increase(realtron_deal_locks_total{status=\"released\"}[1h]))", "legendFormat": "Released" },
        { "expr": "sum(increase(realtron_deal_locks_total{status=\"cancelled\"}[1h]))", "legendFormat": "Cancelled" },
        { "expr": "sum(increase(realtron_deal_locks_total{status=\"disputed\"}[1h]))", "legendFormat": "Disputed" }
      ],
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 10,
      "title": "Webhook Events by Gateway & Result",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{
        "expr": "sum(rate(realtron_webhook_events_total[5m])) by (gateway, result) * 60",
        "legendFormat": "{{gateway}}/{{result}}"
      }]
    },

    {
      "id": 11,
      "title": "Leads Created (per hour)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 24, "w": 6, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{
        "expr": "sum(increase(realtron_leads_created_total[1h]))",
        "legendFormat": "leads/hr"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },

    {
      "id": 12,
      "title": "Active Deal Locks",
      "type": "stat",
      "gridPos": { "x": 18, "y": 24, "w": 6, "h": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [{
        "expr": "realtron_active_deals",
        "legendFormat": "active deals"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    }

  ]
}
