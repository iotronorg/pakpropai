{
  "title": "RealTron — SLOs",
  "uid": "realtron-slo",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "realtron",
    "slo"
  ],
  "description": "Service-level objectives (ADR-050). Targets: apps/core/slo.py; rules: ops/prometheus-alerts.yaml. 30-day figures average the 1 h error ratio, so they need 30 days of Prometheus retention.",
  "panels": [
    {
      "type": "table",
      "title": "Firing alerts",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true
        }
      ],
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Outbox: oldest undelivered message (s)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "realtron_outbox_oldest_undelivered_seconds",
          "legendFormat": "{{kind}}"
        }
      ],
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "row",
      "title": "API availability (non-5xx) — objective 99.5% over 30 days",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": [],
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Compliance (30 d)",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 4,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "1 - avg (avg_over_time(slo:sli_error:ratio_rate1h{slo=\"api_availability\"}[30d]))",
          "legendFormat": "api_availability"
        }
      ],
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Error budget left (30 d)",
      "gridPos": {
        "x": 4,
        "y": 7,
        "w": 4,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "1 - avg (avg_over_time(slo:sli_error:ratio_rate1h{slo=\"api_availability\"}[30d])) / 0.005",
          "legendFormat": "api_availability"
        }
      ],
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Error ratio (5 m, 1 h) vs budget",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 16,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "slo:sli_error:ratio_rate5m{slo=\"api_availability\"}",
          "legendFormat": "5m api_availability"
